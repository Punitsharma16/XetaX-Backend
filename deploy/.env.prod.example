# =============================================================================
#  XetaX CRM — production environment
#  cp .env.prod.example .env   →   fill every CHANGE_ME   →   docker compose up -d
#  NEVER commit .env. Generate secrets with:  openssl rand -hex 32
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Public URLs  (must match the Caddyfile hostnames + Google/Meta consoles)
# -----------------------------------------------------------------------------
APP_PUBLIC_BASE_URL=https://app.xetacrm.pro
APP_API_BASE_URL=https://api.xetacrm.pro
APP_CORS_ORIGINS=https://app.xetacrm.pro,https://xetacrm.pro,https://www.xetacrm.pro


# -----------------------------------------------------------------------------
# 2. Databases  (hosts/ports are injected by docker-compose — only credentials here)
# -----------------------------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_mysql_root_password

MONGO_USERNAME=xetax
MONGO_PASSWORD=CHANGE_ME_mongo_password

# Qdrant vector DB (AI knowledge). First boot only: QDRANT_INIT_SCHEMA=true
# creates the collection — then set it back to false and restart.
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key
QDRANT_INIT_SCHEMA=true


# -----------------------------------------------------------------------------
# 3. Security  (all of these must be unique per deployment)
# -----------------------------------------------------------------------------
# JWT signing key — 64 hex chars. Rotating it signs every user out.
JWT_SECRET=CHANGE_ME_64_hex_chars_from_openssl_rand_hex_32
ISSUER=api.xetacrm.pro
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_COOKIE_SECURE=true
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=lax
JWT_DOMAIN=xetacrm.pro

# Gate for /api/internal/billing (subscription activation via curl) — 64 hex.
INTERNAL_ADMIN_KEY=CHANGE_ME_64_hex_chars

# Encrypts every customer's WhatsApp token at rest (AES-GCM). 64 hex chars.
# !! Set once, back it up, NEVER change after launch — or every customer must reconnect WhatsApp.
WHATSAPP_TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_set_once_never_rotate


# -----------------------------------------------------------------------------
# 4. AI providers
# -----------------------------------------------------------------------------
# Chat / agents (Groq). console.groq.com → API Keys
GROQ_API_KEY=CHANGE_ME_gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Embeddings for AI knowledge (Cohere embed-v4.0). dashboard.cohere.com → API Keys
COHERE_API_KEY=CHANGE_ME_cohere_api_key


# -----------------------------------------------------------------------------
# 5. Email (SMTP) — forgot-password OTP, meeting invites, digests, SEND_EMAIL automations
#    Gmail: smtp.gmail.com / 587 / your address / an App Password (not the login password)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@xetacrm.pro
SMTP_PASSWORD=CHANGE_ME_smtp_app_password


# -----------------------------------------------------------------------------
# 6. Meta / WhatsApp Business  (developers.facebook.com → your app)
#    Webhook URL to register in Meta: https://api.xetacrm.pro/api/public/whatsapp/webhook
# -----------------------------------------------------------------------------
META_GRAPH_API_VERSION=v23.0
META_APP_ID=CHANGE_ME_meta_app_id
META_APP_SECRET=CHANGE_ME_meta_app_secret
# Embedded-signup configuration id (WhatsApp → Embedded signup → Configuration)
META_WHATSAPP_CONFIG_ID=CHANGE_ME_config_id
# Same string you type into Meta's webhook "Verify token" box
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_verify_token
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_SENDS_PER_MINUTE=60
META_API_CONNECT_TIMEOUT_MS=5000
META_API_READ_TIMEOUT_MS=15000
META_API_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# 7. Payments — Razorpay LIVE keys (dashboard.razorpay.com → Account & Settings → API Keys)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=CHANGE_ME_rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME_razorpay_live_secret


# -----------------------------------------------------------------------------
# 8. Social login
#    Google Cloud Console → Credentials → OAuth client (Web)
#    Authorized redirect URI: https://api.xetacrm.pro/login/oauth2/code/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME_xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
# !! Never leave an OAuth key EMPTY (GOOGLE_CLIENT_ID=) — an empty value crashes the
#    boot. Until you have real Google credentials, delete both lines entirely.


# -----------------------------------------------------------------------------
# 9. Optional / scale-later
# -----------------------------------------------------------------------------
# Kafka is NOT in docker-compose — the app falls back to inline processing.
# Add a Redpanda/Kafka service later and point this at it.
# KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# Broker chalao to compose me KAFKA_PUBLISH_ENABLED / KAFKA_LISTENERS_ENABLED dono "true" karo.

# Where uploaded files live inside the container (bind to the `uploads` volume).
APP_UPLOAD_DIR=/app/uploads
