# Copy to .env in this folder. NEVER commit .env.
# DB/Mongo/Redis/Qdrant hosts are injected by docker-compose — don't set them here.

# --- database ---
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_strong_mysql_password

# --- security (generate: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_64_hex_chars
ISSUER=xetax
INTERNAL_ADMIN_KEY=CHANGE_ME_another_random_hex
WHATSAPP_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_verify_token

# --- public URLs (must match the Caddyfile hostnames) ---
APP_PUBLIC_BASE_URL=https://app.xetax.in
APP_API_BASE_URL=https://api.xetax.in
APP_CORS_ORIGINS=https://app.xetax.in,https://xetax.in,https://www.xetax.in

# --- AI ---
GROQ_API_KEY=
COHERE_API_KEY=

# --- email (forgot-password OTP, digests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Meta / WhatsApp (embedded signup) ---
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_SENDS_PER_MINUTE=60

# --- payments (LIVE keys in prod) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- social login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- first boot only: create the Qdrant collection, then set back to false ---
QDRANT_INIT_SCHEMA=true
