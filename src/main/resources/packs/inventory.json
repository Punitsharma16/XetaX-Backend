{
  "key": "inventory",
  "name": "Inventory / Procurement",
  "icon": "bi-box-seam",
  "color": "#0891b2",
  "tagline": "From stock request to shelf",
  "description": "Approve purchase requests, track orders and let stock update itself.",
  "fields": [
    {
      "label": "Item Name",
      "fieldKey": "item_name",
      "fieldType": "TEXT",
      "required": true,
      "optionsJson": null
    },
    {
      "label": "SKU",
      "fieldKey": "sku",
      "fieldType": "TEXT",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Quantity",
      "fieldKey": "quantity",
      "fieldType": "NUMBER",
      "required": true,
      "optionsJson": null
    },
    {
      "label": "Supplier",
      "fieldKey": "supplier",
      "fieldType": "TEXT",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Supplier Email",
      "fieldKey": "supplier_email",
      "fieldType": "EMAIL",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Current Stock",
      "fieldKey": "current_stock",
      "fieldType": "NUMBER",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Reorder Level",
      "fieldKey": "reorder_level",
      "fieldType": "NUMBER",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Unit Price",
      "fieldKey": "unit_price",
      "fieldType": "NUMBER",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Requested By",
      "fieldKey": "requested_by",
      "fieldType": "TEXT",
      "required": false,
      "optionsJson": null
    },
    {
      "label": "Requester Phone",
      "fieldKey": "requester_phone",
      "fieldType": "TEXT",
      "required": false,
      "optionsJson": null
    }
  ],
  "stages": [
    {
      "name": "Requested",
      "code": "REQUESTED",
      "sequence": 1,
      "isDefault": true,
      "isFinal": false,
      "color": "#6366f1",
      "statuses": []
    },
    {
      "name": "Approved",
      "code": "APPROVED",
      "sequence": 2,
      "isDefault": false,
      "isFinal": false,
      "color": "#0ea5e9",
      "statuses": []
    },
    {
      "name": "Ordered",
      "code": "ORDERED",
      "sequence": 3,
      "isDefault": false,
      "isFinal": false,
      "color": "#f59e0b",
      "statuses": [
        {
          "name": "PO Sent",
          "color": "#f59e0b",
          "isDefault": true
        },
        {
          "name": "Partially Received",
          "color": "#0ea5e9",
          "isDefault": false
        },
        {
          "name": "Delayed",
          "color": "#ef4444",
          "isDefault": false
        }
      ]
    },
    {
      "name": "Received",
      "code": "RECEIVED",
      "sequence": 4,
      "isDefault": false,
      "isFinal": false,
      "color": "#a855f7",
      "statuses": []
    },
    {
      "name": "Stocked",
      "code": "STOCKED",
      "sequence": 5,
      "isDefault": false,
      "isFinal": true,
      "color": "#22c55e",
      "statuses": []
    },
    {
      "name": "Rejected",
      "code": "REJECTED",
      "sequence": 6,
      "isDefault": false,
      "isFinal": true,
      "color": "#ef4444",
      "statuses": []
    }
  ],
  "automations": [
    {
      "name": "PO email to supplier",
      "trigger": "STAGE_CHANGED",
      "triggerStageCode": "ORDERED",
      "triggerStatusName": null,
      "actionType": "SEND_EMAIL",
      "actionFieldKey": "supplier_email",
      "actionValue": null,
      "emailSubject": "Purchase Order - {item_name}",
      "emailMessage": "Order: {quantity} x {item_name} (SKU {sku}). Kindly confirm delivery date.",
      "note": "A purchase-order email to the supplier at the ordered stage"
    },
    {
      "name": "Stock update on receive",
      "trigger": "STAGE_CHANGED",
      "triggerStageCode": "RECEIVED",
      "triggerStatusName": null,
      "actionType": "ADJUST_FIELD",
      "actionFieldKey": "current_stock",
      "actionValue": "1",
      "emailSubject": null,
      "emailMessage": null,
      "note": "Raise stock on receipt — adjust the quantity to suit you"
    },
    {
      "name": "Chase the delivery",
      "trigger": "STAGE_CHANGED",
      "triggerStageCode": "ORDERED",
      "triggerStatusName": null,
      "actionType": "CREATE_TASK",
      "actionFieldKey": null,
      "actionValue": "Follow up with {supplier} on {item_name}",
      "emailSubject": null,
      "emailMessage": null,
      "note": "Ordered is where things go quiet — a task keeps the delivery chased"
    },
    {
      "name": "Tell the requester it arrived",
      "trigger": "STAGE_CHANGED",
      "triggerStageCode": "RECEIVED",
      "triggerStatusName": null,
      "actionType": "SEND_WHATSAPP",
      "actionFieldKey": "requester_phone",
      "actionValue": null,
      "emailSubject": null,
      "emailMessage": "{requested_by} ji, {item_name} aa gaya hai ({quantity} nos). Stock mein chadha diya gaya hai.",
      "note": "Whoever raised the request hears the moment the goods land"
    },
    {
      "name": "Low stock alert",
      "trigger": "RECORD_UPDATED",
      "triggerStageCode": null,
      "triggerStatusName": null,
      "actionType": "SEND_EMAIL",
      "actionFieldKey": "supplier_email",
      "actionValue": null,
      "emailSubject": "Low stock - {item_name}",
      "emailMessage": "{item_name} is down to {current_stock}, below its reorder level of {reorder_level}.\nPlease quote for a fresh supply.\n\nSKU: {sku}",
      "note": "Fires only while current_stock is under reorder_level - see conditions",
      "conditions": [
        {
          "fieldKey": "current_stock",
          "operator": "LESS_THAN",
          "value": "{reorder_level}"
        }
      ]
    }
  ],
  "industry": "Procurement / Inventory",
  "tags": [
    "purchase",
    "vendor",
    "stock"
  ],
  "language": "en",
  "whatsappTemplates": [
    {
      "name": "po_sent_vendor",
      "purpose": "Purchase order sent to a vendor",
      "category": "UTILITY",
      "language": "en",
      "bodyText": "Hello {{1}}, purchase order {{2}} has been sent. Please confirm the delivery date by replying here.",
      "exampleParams": [
        "Sharma Traders",
        "PO-118"
      ]
    },
    {
      "name": "delivery_followup",
      "purpose": "Chase a pending delivery",
      "category": "UTILITY",
      "language": "en",
      "bodyText": "Hello {{1}}, order {{2}} is still pending on our side. Could you share the dispatch status?",
      "exampleParams": [
        "Sharma Traders",
        "PO-118"
      ]
    }
  ],
  "playbook": {
    "goal": "Every purchase request gets approved, ordered and received on time — chase vendors automatically.",
    "qualificationKeys": [
      "quantity",
      "supplier"
    ],
    "quietStart": 20,
    "quietEnd": 9,
    "maxFollowUps": 3,
    "rules": [
      {
        "name": "Request pending approval 2 days",
        "trigger": "STAGE_IDLE",
        "action": "CREATE_TASK",
        "active": true,
        "afterMinutes": 2880,
        "stageCodes": [
          "REQUESTED"
        ],
        "taskTitle": "Approve or reject this purchase request",
        "taskDueHours": 24,
        "message": "Pending approval for 2 days: {item_name} x {quantity}"
      },
      {
        "name": "Ordered but not received in 7 days",
        "trigger": "STAGE_IDLE",
        "action": "SEND_MESSAGE",
        "active": true,
        "afterMinutes": 10080,
        "stageCodes": [
          "ORDERED"
        ],
        "maxRepeats": 2,
        "repeatEveryMinutes": 4320,
        "aiCompose": false,
        "templateName": null,
        "message": "Hello {supplier}, our order for {item_name} ({quantity}) is still pending on our side. Could you share the dispatch status?",
        "templateParams": []
      }
    ]
  },
  "agent": {
    "name": "Procurement Assistant",
    "persona": "You are a precise, unhurried procurement assistant for a stores team. Take stock requests, confirm the item, how many and who is asking, and say what stock is on hand when you know it. Quote only prices and suppliers you can see in the knowledge; never invent a rate or a delivery date. Hand off to a person for approvals, payment terms or anything about a disputed delivery.",
    "welcomeMessage": "Hi! Tell me what you need and how many, and I'll raise the request.",
    "handoffKeywords": "approve, payment, invoice, dispute, return, urgent, human, manager",
    "pipelineMode": "SUGGEST",
    "captureFields": true,
    "stageHints": [
      {
        "stageCode": "REQUESTED",
        "hint": "the item and quantity are known"
      },
      {
        "stageCode": "ORDERED",
        "hint": "a supplier has been chosen and the order placed"
      },
      {
        "stageCode": "RECEIVED",
        "hint": "the goods have physically arrived"
      }
    ]
  }
}
