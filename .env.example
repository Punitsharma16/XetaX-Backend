
# --- AI providers (REQUIRED — app's AI features need both) ---
GROQ_API_KEY=
COHERE_API_KEY=

# --- Database & infra (defaults suit local dev; SET ALL of these in production) ---
DB_URL=jdbc:mysql://localhost:3306/crm
DB_USERNAME=root
DB_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/crm
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost

# --- Security (MUST change in production) ---
JWT_SECRET=
JWT_COOKIE_SECURE=true

# --- URLs (production domain) ---
APP_PUBLIC_BASE_URL=https://app.yourdomain.com
APP_API_BASE_URL=https://api.yourdomain.com
APP_CORS_ORIGINS=https://app.yourdomain.com
APP_UPLOAD_DIR=/opt/xetax/uploads

# XetaX CRM — environment template. Copy to .env and fill real values.
# NEVER commit .env with real credentials.

# --- Auth / JWT ---
JWT_SECRET=<64_CHAR_RANDOM_SECRET>
ISSUER=api.substring.com

# --- AI providers ---
GROQ_API_KEY=<GROQ_API_KEY>

# --- OAuth social login (optional) ---
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>

# --- WhatsApp / Meta (App Dashboard -> Settings -> Basic) ---
META_GRAPH_API_VERSION=<CURRENT_SUPPORTED_VERSION e.g. v23.0>
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
# Embedded Signup configuration id (Facebook Login for Business -> Configurations)
META_WHATSAPP_CONFIG_ID=<EMBEDDED_SIGNUP_CONFIGURATION_ID>
# Must match the token typed into Meta webhook setup screen
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<RANDOM_SECRET>
# 32+ char random string; NEVER change once set (stored tokens become unreadable)
WHATSAPP_TOKEN_ENCRYPTION_KEY=<32_BYTE_SECRET>
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_SENDS_PER_MINUTE=60

# --- Meta API client tuning ---
META_API_CONNECT_TIMEOUT_MS=5000
META_API_READ_TIMEOUT_MS=15000
META_API_MAX_RETRIES=2

# --- Kafka (campaign queue + webhook DLR events) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- SMTP for outgoing email (empty host = email disabled) ---
SMTP_HOST=<smtp.gmail.com or provider host>
SMTP_PORT=587
SMTP_USERNAME=<from address / login>
SMTP_PASSWORD=<app password>

# --- Back-office billing API (plan activation via curl; empty = disabled) ---
INTERNAL_ADMIN_KEY=<long random string>
